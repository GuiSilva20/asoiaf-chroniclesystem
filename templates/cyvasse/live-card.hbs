        <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
        <span>{{title}}</span>
    </header>
    <p>{{body}}</p>
    <button type="button" class="cs-cyvasse-watch">
        <i class="fa-solid fa-chess-board" aria-hidden="true"></i> {{watchLabel}}
    </button>
</div>
