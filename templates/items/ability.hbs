<form class="{{cssClass}}" autocomplete="off">
    {{!-- Item Sheet Header --}} {{>
    "systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <main class="sheet-body flexrow">
        {{#if item.isOwned}}
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            <div class="form-group">
                <label for="system.rating">{{localize "CS.ui.abilityItem.ratingLabel"}}</label>
                <span class="form-fields">
                  <input
                          id="system.rating"
                          class="small-field"
                          name="system.rating"
                          type="number"
                          min="0"
                          step="1"
                          value="{{item.system.rating}}"
                          placeholder="{{localize 'CS.ui.common.rating'}}"
                          data-dtype="Number"
                  />
                </span>
            </div>
            <div class="form-group">
                <label for="system.modifier">{{localize "CS.ui.abilityItem.modifierLabel"}}</label>
                <span class="form-fields">
                  <input
                          id="system.modifier"
                          class="small-field"
                          name="system.modifier"
                          type="number"
                          step="1"
                          value="{{item.system.modifier}}"
                          placeholder="{{localize 'CS.ui.common.modifier'}}"
                          data-dtype="Number"
                  />
                </span>
            </div>
            <p class="ps">{{localize "CS.sheets.abilityItem.ratingHint"}}</p>
        </section>
        {{/if}}
        <section class="description">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
            <header class="header-field flexrow">
                <div class="header-title">
                    <span>{{localize "CS.ui.abilityItem.specialties"}}</span>
                </div>
                <div class="header-field-add">
                    <a class="specialty-create" data-type="skill"><i class="fa fa-plus"></i></a>
                </div>
            </header>

            {{#if suggestedSpecialties.length}}
                {{!-- the specialties this ability lists in the rulebook; the
                      name field stays free text so the table can add its own --}}
                <datalist id="cs-specialties-{{item.id}}">
                    {{#each suggestedSpecialties as |suggestion|}}
                        <option value="{{suggestion}}"></option>
                    {{/each}}
                </datalist>
            {{/if}}

            <ol class="specialties-list list resizable" data-base-size="150">
                {{#each item.system.specialties as |specialty id|}}
                    <li class="specialty item flexrow" data-item-id="{{id}}">
                        <!--suppress HtmlFormInputWithoutLabel -->
                        <input
                                class="big-field"
                                type="text"
                                name="system.specialties.{{id}}.name"
                                value="{{specialty.name}}"
                                placeholder="{{localize 'CS.ui.abilityItem.specialtyName'}}"
                                data-dtype="String"
                                list="cs-specialties-{{../item.id}}"
                        />
                        <!--suppress HtmlFormInputWithoutLabel -->
                        {{#if ../item.isOwned}}
                        <input
                                class="small-field"
                                type="number"
                                min="0"
                                max="{{../item.system.rating}}"
                                step="1"
                                name="system.specialties.{{id}}.rating"
                                value="{{specialty.rating}}"
                                placeholder="{{localize 'CS.ui.common.rating'}}"
                                data-dtype="Number"
                                title="{{localize 'CS.sheets.abilityItem.specialtyCapHint'}}"
                        />
                        <!--suppress HtmlFormInputWithoutLabel -->
                        <input
                                class="small-field"
                                type="number"
                                step="1"
                                name="system.specialties.{{id}}.modifier"
                                value="{{specialty.modifier}}"
                                placeholder="{{localize 'CS.ui.common.modifier'}}"
                                data-dtype="Number"
                        />
                        {{/if}}
                        <a class="specialty-control item-controls" data-id="{{id}}" data-action="delete"><i class="fas fa-trash"></i></a>
                    </li>
                {{/each}}
            </ol>
        </section>

    </main>
</form>
