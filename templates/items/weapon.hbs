<form class="{{cssClass}}" autocomplete="off">
    {{!-- Item Sheet Header --}} {{>
    "systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <main class="sheet-body flexrow">
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            <div class="form-group">
                <label for="system.specialty">{{localize "CS.ui.weaponItem.testLabel"}}</label>
                <span class="form-fields">
                  <select
                          id="system.specialty"
                          class="medium-field"
                          name="system.specialty"
                          data-dtype="String"
                  >
                      <option value="">{{localize "CS.sheets.generalLabels.none"}}</option>
                      {{#each abilitySpecialtyOptions}}
                          <option value="{{this.value}}" {{#if (csCompare this.value "===" ../currentTestValue)}}selected{{/if}}>{{this.label}}</option>
                      {{/each}}
                  </select>
                </span>
            </div>
            <div class="form-group">
                <label for="system.reach">Reach:</label>
                <span class="form-fields">
                  <input
                          id="system.reach"
                          class="small-field"
                          name="system.reach"
                          type="text"
                          value="{{item.system.reach}}"
                          placeholder="Reach"
                          data-dtype="Number"
                  />
                </span>
            </div>
            <div class="form-group">
                <label for="system.training">Training:</label>
                <span class="form-fields">
                  <input
                          id="system.training"
                          class="small-field"
                          name="system.training"
                          type="text"
                          value="{{item.system.training}}"
                          placeholder="Training"
                          data-dtype="Number"
                  />
                </span>
            </div>
            <div class="form-group">
                <label for="damage.abilityKey">{{localize "CS.ui.weaponItem.damageLabel"}}</label>
                <span class="form-fields">
                  <select id="damage.abilityKey" name="damage.abilityKey" data-dtype="String">
                      <option value="">{{localize "CS.sheets.generalLabels.none"}}</option>
                      {{#each abilityOptions}}
                          <option value="{{this.value}}" {{#if (csCompare this.value "===" ../damage.abilityKey)}}selected{{/if}}>{{this.label}}</option>
                      {{/each}}
                  </select>
                  <select id="damage.operator" name="damage.operator" class="short-field" data-dtype="String">
                      {{#each damageOperators}}
                          <option value="{{this}}" {{#if (csCompare this "===" ../damage.operator)}}selected{{/if}}>{{#if this}}{{this}}{{else}}&mdash;{{/if}}</option>
                      {{/each}}
                  </select>
                  <input
                          id="damage.modifier"
                          class="short-field"
                          name="damage.modifier"
                          type="number"
                          min="0"
                          value="{{damage.modifier}}"
                          data-dtype="String"
                  />
                </span>
            </div>
            {{> "systems/chroniclesystem/templates/items/partials/physical-item.hbs"}}
            {{> "systems/chroniclesystem/templates/items/partials/equipment-item.hbs"}}
        </section>
        <section class="description">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
            <header class="header-field flexrow">
                <div class="header-title">
                    <span>Qualities</span>
                </div>
                <div class="header-field-add">
                    <a class="item-quality-create" data-type="skill"><i class="fa fa-plus"></i></a>
                </div>
            </header>
            <ol class="qualities-list list resizable" data-base-size="150">

                {{#each item.system.qualities as |quality index|}}
                    <li class="weapon-quality item flexrow" data-item-id="{{index}}">
                        <!--suppress HtmlFormInputWithoutLabel -->
                        <input
                                class="big-field"
                                type="text"
                                name="system.qualities.{{index}}.name"
                                value="{{quality.name}}"
                                placeholder="Weapon Quality Name"
                                data-dtype="String"
                        />
                        <!--suppress HtmlFormInputWithoutLabel -->
                        <input
                                class="small-field"
                                type="text"
                                name="system.qualities.{{index}}.parameter"
                                value="{{quality.parameter}}"
                                placeholder="Parameter"
                                data-dtype="String"
                        />
                        <a class="item-qualities-control item-controls" data-id="{{index}}" data-action="delete"><i class="fas fa-trash"></i></a>
                    </li>
                {{/each}}
            </ol>
        </section>
    </main>
</form>
