<div class="tab flexrow" data-group="primary" data-tab="qualities">
    <section class="benefits">
        <header class="header-field flexrow">
            <div class="header-title">
                <span>{{localize "CS.ui.qualities.benefits"}}</span>
            </div>
            {{#if @root.owner}}
                <div class="header-field-add">
                    <a class="item-create" data-type="benefit" title="{{localize 'CS.sheets.generalLabels.add'}}"><i class="fa fa-plus"></i></a>
                </div>
            {{/if}}
        </header>
        <ol  class="qualities-list">
            {{#each character.owned.benefits}}
                <li  class="item quality" data-item-id="{{_id}}">
                    <div class="quality-label item-name">
                        <label class="flex3">{{name}} </label>
                        {{#if ../owner}}
                        <div class='item-controls'>
                            <button type='button' class='item-edit' title="{{localize 'CS.sheets.generalLabels.edit'}}">
                                <i class='fas fa-edit'></i>
                            </button>
                            <button type='button' class='item-delete' title="{{localize 'CS.sheets.generalLabels.delete'}}">
                                <i class='fas fa-trash'></i>
                            </button>
                        </div>
                        {{/if}}
                    </div>

                    <div class="description">{{{enrichedDescription}}}</div>
                </li>
            {{/each}}
        </ol>
    </section>
    <section class="drawbacks">
        <header class="header-field flexrow">
            <div class="header-title">
                <span>{{localize "CS.ui.qualities.drawbacks"}}</span>
            </div>
            {{#if @root.owner}}
                <div class="header-field-add">
                    <a class="item-create" data-type="drawback" title="{{localize 'CS.sheets.generalLabels.add'}}"><i class="fa fa-plus"></i></a>
                </div>
            {{/if}}
        </header>
        <ol  class="qualities-list">
            {{#each character.owned.drawbacks}}
                <li  class="item quality" data-item-id="{{_id}}">
                    <div class="quality-label item-name">
                        <label class="flex3">{{name}} </label>
                        {{#if ../owner}}
                            <div class='item-controls'>
                                <button type='button' class='item-edit' title="{{localize 'CS.sheets.generalLabels.edit'}}">
                                    <i class='fas fa-edit'></i>
                                </button>
                                <button type='button' class='item-delete' title="{{localize 'CS.sheets.generalLabels.delete'}}">
                                    <i class='fas fa-trash'></i>
                                </button>
                            </div>
                        {{/if}}
                    </div>
                    <div class="description">{{{enrichedDescription}}}</div>
                </li>
            {{/each}}
        </ol>
    </section>
</div>
