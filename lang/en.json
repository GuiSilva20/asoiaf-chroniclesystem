    "combat": {
      "critical": {
        "rows": {
          "1": {
            "label": "Solid Hit",
            "desc": "You land a firm blow. Increase the weapon's base damage by +2 for this attack."
          },
          "2": {
            "label": "Powerful Hit",
            "desc": "Your attack leaves the opponent shaken. Increase the weapon's base damage by +4 for this attack."
          },
          "3": {
            "label": "Bloody Wound",
            "desc": "Your attack causes bleeding. In addition to the damage dealt, your target gains 1 wound. This wound does not reduce the damage. If the opponent cannot take another wound, they suffer an injury instead. If they cannot take an injury, they die."
          },
          "4": {
            "label": "Incapacitating Wound",
            "desc": "You leave your opponent incapacitated with a horrible wound. In addition to the damage dealt, your target gains 1 injury. This injury does not reduce the damage. If the opponent cannot take another injury, they die."
          },
          "5": {
            "label": "Killing Blow",
            "desc": "Your attack kills the opponent instantly."
          },
          "6": {
            "label": "Terrible Blow",
            "desc": "In addition to instantly killing your enemy, you deal your base damage (unchanged by the degree of success) to all opponents adjacent to the victim."
          },
          "7": {
            "label": "Impressive Death",
            "desc": "Your attack kills the opponent. It is also so impressive that your allies gain +1B on all tests until the end of combat."
          },
          "8": {
            "label": "Horrendous Death",
            "desc": "You kill your opponent with such force that it shakes every witness. Every character (allies and enemies) who witnessed the attack must succeed at a Challenging (9) Willpower test or suffer -1D on all tests for a round. You gain +1B on all tests until the end of combat."
          }
        }
      },
      "fumble": {
        "rows": {
          "1": {
            "label": "Self-Inflicted Wound",
            "desc": "Mishandling your weapon, you wound yourself. Suffer the weapon's damage."
          },
          "2": {
            "label": "Hit an Ally",
            "desc": "You hit an ally instead of the target. If an ally is adjacent, make a Fighting test. If an ally is in range, make a Marksmanship test. You use the result of this test to hit the ally, as if it were any other target."
          },
          "3": {
            "label": "Drop Weapon",
            "desc": "The weapon slips from your hand, landing 1d6 meters away in a random direction."
          },
          "4": {
            "label": "Minor Damage",
            "desc": "The weapon is damaged from excessive use. Reduce its damage by -1. If the weapon's quality is castle-forged or better, treat this result as a '3' (above) instead."
          },
          "5": {
            "label": "Broken",
            "desc": "The weapon breaks or becomes too damaged. It is now useless and cannot be repaired. If the weapon is castle-forged, treat this result as a '4' (above). If the weapon is Valyrian steel, treat this result as a '3'."
          },
          "6": {
            "label": "Slippery Grip",
            "desc": "Blood or sweat makes the weapon's grip slippery. Suffer -1D on all attacks until the end of your next turn."
          },
          "7": {
            "label": "Blood in the Eyes",
            "desc": "Blood or sweat gets in your eyes, affecting your vision. Suffer -1D on all tests until the end of your next turn."
          },
          "8": {
            "label": "Overextended Attack",
            "desc": "In your eagerness to hit your opponent, you lose your balance and leave an opening in your guard. Suffer a -5 penalty to Combat Defense until the start of your next turn."
          }
        }
      }
    },
